# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
LOG_LEVEL=

# ---- Frontend -----------------------------------------------
# Supplier Service base URL.
VITE_SUPPLIER_API_URL=http://localhost:8080
# User Service base URL.
VITE_USER_API_URL=http://localhost:8081
# Order Service base URL.
VITE_ORDER_API_URL=http://localhost:8002
VITE_MOCK_AUTH=false

# ---- Service-to-service URLs -------------------------------
# URLs used when services run directly on the host machine.
USER_SERVICE_URL=http://localhost:8081
SUPPLIER_SERVICE_URL=http://localhost:8080

# URLs used when services run inside Docker Compose.
USER_SERVICE_DOCKER_URL=http://user-service:8080
SUPPLIER_SERVICE_DOCKER_URL=http://supplier-service:8080
CREDIT_SERVICE_DOCKER_URL=http://credit-service:8080
CREDIT_SERVICE_TIMEOUT=5
# Generate a long random secret; share it only between Order and Credit Service.
ORDER_CREDIT_SERVICE_KEY=

# ---- Events (Kafka Connect / Debezium) ---------------------
# No variables of its own: the connectors in debezium/connectors read the
# *_DB_NAME / *_DB_USERNAME / *_DB_PASSWORD values below.

# ---- Auth / JWT -----------
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=

# Issuer value embedded in access tokens by the User Service.
JWT_ISSUER=campuscouriers-user-service

# ---- Supplier Service Database -----------------------------
SUPPLIER_DB_NAME=campuscouriers_supplier
SUPPLIER_DB_USERNAME=supplier
SUPPLIER_DB_PASSWORD=password
SUPPLIER_DB_PORT=5433
SUPPLIER_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Order Service ------------------------------------------
ORDER_SERVICE_PORT=8002
ORDER_DB_NAME=campuscouriers_order
ORDER_DB_USERNAME=order_service
ORDER_DB_PASSWORD=password
ORDER_DB_PORT=5435
ORDER_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Credit Service -----------------------------------------
CREDIT_SERVICE_PORT=8001
CREDIT_DB_NAME=campuscouriers_credit
CREDIT_DB_USERNAME=credit_service
CREDIT_DB_PASSWORD=password
CREDIT_DB_PORT=5431

# ---- User Service ------------------------------------------
USER_SERVICE_PORT=8081
USER_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- User Service Database ---------------------------------
USER_DB_NAME=campuscouriers_user
USER_DB_USERNAME=user_service
USER_DB_PASSWORD=change-me
USER_DB_PORT=5434

# ---- User Service First Administrator ----------------------
# Creates the first Administrator on startup if none exists; ignored once one exists.
# Set all three or none (partial configuration fails startup). Email must be an NUS
# address; the password must follow the registration policy (16-128 chars, upper,
# lower, digit, special). Leave empty to skip (a warning is logged).
# e.g. BOOTSTRAP_ADMIN_NAME=Administrator  BOOTSTRAP_ADMIN_EMAIL=admin@u.nus.edu
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ... Add more variables as needed
