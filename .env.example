# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
LOG_LEVEL=

# ---- Frontend -----------------------------------------------
# Supplier Service base URL.
VITE_SUPPLIER_API_URL=http://localhost:8080

# ---- Auth / JWT -----------
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=

# ---- Supplier Service Database -----------------------------
SUPPLIER_DB_NAME=campuscouriers_supplier
SUPPLIER_DB_USERNAME=supplier
SUPPLIER_DB_PASSWORD=password
SUPPLIER_DB_PORT=5433
SUPPLIER_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- User Service ------------------------------------------
USER_SERVICE_PORT=8081
USER_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- User Service Database ---------------------------------
USER_DB_NAME=campuscouriers_user
USER_DB_USERNAME=user_service
USER_DB_PASSWORD=change-me
USER_DB_PORT=5434

# ---- User Service First Administrator ----------------------
# Creates the first Administrator on startup if none exists; ignored once one exists.
# Set all three or none (partial configuration fails startup). Email must be an NUS
# address; the password must follow the registration policy (16-128 chars, upper,
# lower, digit, special). Leave empty to skip (a warning is logged).
# e.g. BOOTSTRAP_ADMIN_NAME=Administrator  BOOTSTRAP_ADMIN_EMAIL=admin@u.nus.edu
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ... Add more variables as needed
