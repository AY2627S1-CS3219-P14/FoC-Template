# AI Assistance Disclosure
# Tool and date: Anthropic Claude (model unrecorded), 2026-11-10 to 2026-11-11
# Scope (AI-29): Generated manifests, secret wiring and service changes to deploy the AI assistant and RAG services.
# Usage log: AI_USAGE_LOG.md
# Author review: Pending confirmation by Melodi Joy Halim.

# JWT public keys (/.well-known/jwks.json)
USER_SERVICE_URL=http://user-service:8080
JWT_ISSUER=campuscouriers-user-service
# Catalog (suppliers, buildings) and the caller's past errands, fetched with the caller's token
SUPPLIER_SERVICE_URL=http://supplier-service:8080
ORDER_SERVICE_URL=http://order-service:8080
OPENAI_MODEL=gpt-4o-mini
BUSINESS_TIMEZONE=Asia/Singapore
# Draft requests per user per window. Counted per pod, so with N pods a user gets up to N times this
AI_DRAFT_RATE_LIMIT=10
AI_DRAFT_RATE_WINDOW_SECONDS=60
CATALOG_CACHE_SECONDS=60
# from domain.yaml (appOrigin)
CORS_ALLOWED_ORIGINS=set-from-domain-yaml
