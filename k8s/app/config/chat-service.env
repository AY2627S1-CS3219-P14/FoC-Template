# Scope (AI-26): Generated Terraform, Kubernetes manifests and scripts for the AWS resources I specified.
# Usage log: AI_USAGE_LOG.md
# Author review: Pending confirmation by Melodi Joy Halim.

DB_HOST=chat-db
DB_PORT=5432
DB_NAME=campuscouriers_chat
# JWT public keys (/.well-known/jwks.json)
USER_SERVICE_URL=http://user-service:8080
JWT_ISSUER=campuscouriers-user-service
# Consumes errand events to open and close conversations
KAFKA_CONSUMER_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka.campuscouriers-messaging.svc.cluster.local:9092
KAFKA_CHAT_GROUP_ID=chat-service-lifecycle-v1
# How long a WebSocket ticket (from POST .../ws-ticket) stays valid
CHAT_WS_TICKET_TTL_SECONDS=30
# from domain.yaml (appOrigin)
CHAT_CORS_ALLOWED_ORIGINS=set-from-domain-yaml
