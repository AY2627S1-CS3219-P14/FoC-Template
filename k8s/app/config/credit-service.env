DB_HOST=credit-db
DB_PORT=5432
DB_NAME=campuscouriers_credit
USER_SERVICE_URL=http://user-service:8080
SUPPLIER_SERVICE_URL=http://supplier-service:8080
JWT_ISSUER=campuscouriers-user-service
# Kafka is in the other namespace, so use its full DNS name
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka.campuscouriers-messaging.svc.cluster.local:9092
KAFKA_BOOTSTRAP_SERVERS=kafka.campuscouriers-messaging.svc.cluster.local:9092
# from domain.yaml (appOrigin)
CREDIT_CORS_ALLOWED_ORIGINS=set-from-domain-yaml
