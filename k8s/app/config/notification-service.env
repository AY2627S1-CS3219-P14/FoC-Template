SERVER_PORT=8080
DB_HOST=notification-db
DB_PORT=5432
DB_NAME=campuscouriers_notification
KAFKA_BOOTSTRAP_SERVERS=kafka.campuscouriers-messaging.svc.cluster.local:9092
