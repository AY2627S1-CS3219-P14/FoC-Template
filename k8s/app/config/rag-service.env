# Claude model; see k8s/README.md, "API keys". Must be one the key's account offers (Models API).
CLAUDE_MODEL=claude-sonnet-5-5
# Thinking counts toward this as well as the answer
CLAUDE_MAX_TOKENS=2048
# How much the model thinks first: low | medium | high
CLAUDE_EFFORT=low
# Must match the model downloaded into the image (RAG-service/Dockerfile) and the one the chunks were indexed with
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Use only the copy of the embedding model inside the image; never download at startup
HF_HUB_OFFLINE=1
RAG_TOP_K=5
# JWT public keys (/.well-known/jwks.json): /query requires a signed-in user
USER_SERVICE_URL=http://user-service:8080
JWT_ISSUER=campuscouriers-user-service
# from domain.yaml (appOrigin)
RAG_CORS_ALLOWED_ORIGINS=set-from-domain-yaml
