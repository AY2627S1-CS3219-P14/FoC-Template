# ExternalName alias for RDS (k8s/app/database-endpoints.yaml)
DB_HOST=user-db
DB_PORT=5432
DB_NAME=campuscouriers_user
JWT_PRIVATE_KEY_LOCATION=file:/app/keys/private.pem
JWT_PUBLIC_KEY_LOCATION=file:/app/keys/public.pem
# from domain.yaml (appOrigin)
USER_CORS_ALLOWED_ORIGINS=set-from-domain-yaml
