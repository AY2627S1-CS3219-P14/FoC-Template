# Copy to backend.hcl (or paste the `backend_hcl` output of terraform/bootstrap) and commit it:
# it holds no secrets, and every teammate must point at the same state file.
bucket       = "campuscouriers-tfstate-123456789012"
key          = "campuscouriers/infra.tfstate"
region       = "ap-southeast-1"
encrypt      = true
use_lockfile = true # lock file next to the state in S3, so two people can't apply at once
