# RDS for PostgreSQL: one instance holding one database per service, in the database subnets.
#
#   ┌───────────────────── RDS instance (campuscouriers) ─────────────────────┐
#   │ campuscouriers_user          owner user_service          ← Debezium     │
#   │ campuscouriers_supplier      owner supplier_service      ← Debezium     │
#   │ campuscouriers_credit        owner credit_service        ← Debezium     │
#   │ campuscouriers_order         owner order_service         ← Debezium     │
#   │ campuscouriers_chat          owner chat_service          ← Debezium     │
#   │ campuscouriers_notification  owner notification_service                 │
#   │ campuscouriers_rag           owner rag_service           + pgvector     │
#   └──────────────────────────────────────────────────────────────────────────┘
#
# Each service still only sees its own database (database-per-service), but they share one instance,
# which costs a fraction of one each. Give a service its own instance later if it needs to scale alone.
#
# Passwords:
#   - master user: generated and stored in Secrets Manager BY RDS (manage_master_user_password).
#     Only the one-off db-init Job (k8s/ops) uses it, to create the databases and users.
#   - per-service users: generated by Terraform and written straight to Secrets Manager. They are
#     "ephemeral" + "write-only", so they never appear in the Terraform state file or plan output.

locals {
  # service -> does Debezium read its outbox? (those users need the rds_replication role)
  db_services = {
    user         = { cdc = true }
    supplier     = { cdc = true }
    credit       = { cdc = true }
    order        = { cdc = true }
    chat         = { cdc = true }
    notification = { cdc = false }
    rag          = { cdc = false } # RAG-service: knowledge chunks + pgvector embeddings
  }
}

# --- Network ---------------------------------------------------------------------------------------
# Which subnets the instance (and a Multi-AZ standby) may be placed in: the isolated database tier
resource "aws_db_subnet_group" "main" {
  name       = var.project
  subnet_ids = aws_subnet.database[*].id
}

# Firewall: PostgreSQL only, and only from the EKS nodes. Pods use their node's security group
# (the cluster security group), so this covers every pod and nothing outside the cluster.
resource "aws_security_group" "rds" {
  name        = "${var.project}-rds"
  description = "PostgreSQL from the EKS cluster only"
  vpc_id      = aws_vpc.main.id

  tags = {
    Name = "${var.project}-rds"
  }
}

resource "aws_vpc_security_group_ingress_rule" "rds_from_eks" {
  security_group_id            = aws_security_group.rds.id
  referenced_security_group_id = aws_eks_cluster.main.vpc_config[0].cluster_security_group_id
  ip_protocol                  = "tcp"
  from_port                    = 5432
  to_port                      = 5432
  description                  = "EKS nodes and pods"
}

# --- Settings --------------------------------------------------------------------------------------
resource "aws_db_parameter_group" "main" {
  name   = "${var.project}-postgres18"
  family = "postgres18"

  # Debezium reads each outbox table from the write-ahead log (logical replication).
  # The RDS equivalent of `postgres -c wal_level=logical` in compose.yaml.
  # "pending-reboot": this setting only changes on restart; a brand-new instance starts with it.
  parameter {
    name         = "rds.logical_replication"
    value        = "1"
    apply_method = "pending-reboot"
  }

  lifecycle {
    create_before_destroy = true
  }
}

# --- The instance ----------------------------------------------------------------------------------
resource "aws_db_instance" "main" {
  identifier     = var.project
  engine         = "postgres"
  engine_version = "18" # major version only: RDS picks the newest 18.x and applies minor updates
  instance_class = var.db_instance_class

  # Storage starts at 20 GiB and grows automatically up to the max
  allocated_storage     = 20
  max_allocated_storage = 50
  storage_type          = "gp3"
  storage_encrypted     = true

  db_name  = "postgres" # the only database RDS creates; the per-service ones come from db-init
  username = "campuscouriers_admin"
  # RDS generates the master password, stores it in Secrets Manager and rotates it every 7 days
  manage_master_user_password = true

  db_subnet_group_name   = aws_db_subnet_group.main.name
  vpc_security_group_ids = [aws_security_group.rds.id]
  parameter_group_name   = aws_db_parameter_group.main.name
  publicly_accessible    = false
  multi_az               = var.db_multi_az

  backup_retention_period    = var.db_backup_retention_days
  auto_minor_version_upgrade = true
  apply_immediately          = true # apply changes now rather than in the next maintenance window

  # Dev-friendly defaults; see variables.tf before storing anything you can't lose
  deletion_protection       = var.db_deletion_protection
  skip_final_snapshot       = var.db_skip_final_snapshot
  final_snapshot_identifier = var.db_skip_final_snapshot ? null : "${var.project}-final"
}

# --- Per-service credentials -----------------------------------------------------------------------
# A fresh random value on every run, but only kept in memory: never saved to state
ephemeral "random_password" "db" {
  for_each = local.db_services

  length  = 32
  special = false # letters and digits only: no escaping problems in JDBC, psql or shell scripts
}

resource "aws_secretsmanager_secret" "db" {
  for_each = local.db_services

  name                    = "${local.secrets_prefix}db/${each.key}-service"
  description             = "Credentials ${each.key}-service uses for database campuscouriers_${each.key}. JSON keys: DB_USERNAME, DB_PASSWORD"
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_version" "db" {
  for_each = local.db_services

  secret_id = aws_secretsmanager_secret.db[each.key].id

  # Write-only: sent to AWS, never stored in state. Terraform only sends it when the version
  # number changes, so the password stays the same across applies. To rotate: bump the number,
  # apply, re-run the db-init Job, then restart the service.
  secret_string_wo = jsonencode({
    DB_USERNAME = "${each.key}_service"
    DB_PASSWORD = ephemeral.random_password.db[each.key].result
  })
  secret_string_wo_version = 1
}

# Where the database is. Not secret, so Terraform sets the value directly. Read by the db-init Job.
resource "aws_secretsmanager_secret" "db_connection" {
  name                    = "${local.secrets_prefix}db/connection"
  description             = "RDS endpoint. JSON keys: host, port"
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_version" "db_connection" {
  secret_id = aws_secretsmanager_secret.db_connection.id
  secret_string = jsonencode({
    host = aws_db_instance.main.address
    port = tostring(aws_db_instance.main.port)
  })
}
